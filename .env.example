# Copy to .env.local (on your computer) or add in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://andamantravelplanner.com
# Razorpay (Dashboard → Settings → API keys). Leave empty to keep the simulated payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Supabase (stage 3: bookings, customers, prices)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
