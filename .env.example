# Copy to .env.local (on your computer) or add in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://andamantravelplanner.com
# Search and analytics (all optional; leave empty to switch off)
# Google Search Console → Add property → HTML tag → the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag → the content="..." value
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Google Analytics 4 → Admin → Data streams → Measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA4_ID=
# Razorpay (Dashboard → Settings → API keys). Leave empty to keep the simulated payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Supabase (stage 3: bookings, customers, prices)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
